---
---
<section id="home" class="hero-bg noise relative min-h-[92vh] overflow-hidden text-cream">
  <div class="absolute -right-24 top-20 h-72 w-72 rounded-full bg-blush/20 blur-3xl"></div>
  <div class="absolute bottom-10 left-8 h-52 w-52 rounded-full bg-sage/10 blur-3xl"></div>

  <header class="relative z-20 mx-auto flex max-w-7xl items-center justify-between px-5 py-6 lg:px-10">
    <a href="#home" class="group inline-flex items-center gap-3" aria-label="Piąty Żywioł - strona główna">
      <img src="/logo.webp" alt="Piąty Żywioł" class="h-12 w-auto transition group-hover:scale-105" />
      <span class="leading-tight">
        <span class="block font-display text-xl font-semibold tracking-wide">Piąty Żywioł</span>
        <span class="block text-[10px] uppercase tracking-[.28em] text-cream/60">Beauty &amp; Massage</span>
      </span>
    </a>

    <nav class="hidden items-center gap-8 text-xs uppercase tracking-[.22em] text-cream/76 lg:flex">
      <a class="transition hover:text-cream" href="#o-studiu">O studiu</a>
      <a class="transition hover:text-cream" href="#cennik">Cennik</a>
      <a class="transition hover:text-cream" href="#opinie">Opinie</a>
      <a class="transition hover:text-cream" href="#kontakt">Kontakt</a>
    </nav>

    <a href="tel:721050353" class="magnetic inline-flex rounded-full border border-cream/25 px-5 py-3 text-xs font-medium uppercase tracking-[.18em] text-cream/85 hover:border-cream/70 hover:bg-cream/10">
      721 050 353
    </a>
  </header>

  <div class="relative z-10 mx-auto grid min-h-[74vh] max-w-7xl items-center px-5 pb-16 pt-10 lg:grid-cols-[1.05fr_.95fr] lg:px-10">
    <div class="flex items-center justify-center lg:hidden">
      <div class="animate-floatSlow relative h-[420px] w-[420px]">
        <img src="/hero-side.webp" alt="Piąty Żywioł" class="absolute inset-0 h-full w-full object-contain drop-shadow-2xl" />
        <svg class="absolute inset-0 animate-rotateBadge z-10" viewBox="0 0 420 420">
          <defs><path id="heroCircleTextMobile" d="M 210, 210 m -180, 0 a 180,180 0 1,1 360,0 a 180,180 0 1,1 -360,0" /></defs>
          <text class="fill-cream text-[7px] uppercase tracking-[.28em]"><textPath href="#heroCircleTextMobile">Piąty Żywioł &amp; Marta Włodarska Beauty &amp; Massage · </textPath></text>
        </svg>
      </div>
    </div>

    <div class="max-w-3xl reveal is-visible">
      <p class="mb-5 inline-flex items-center gap-3 text-[10px] uppercase tracking-[.38em] text-cream/65">
        <span class="h-px w-12 bg-cream/40"></span>
        Kalisz · masaż twarzy i ciała + zabiegi beauty
      </p>
      <h1 class="font-display text-6xl font-medium leading-[.88] tracking-[-.04em] text-balance md:text-8xl lg:text-9xl">
        <span class="split-line"><span>Znajdź chwilę</span></span>
        <span class="split-line"><span>tylko dla</span></span>
        <span class="split-line"><span>siebie.</span></span>
      </h1>
      <p class="mt-8 max-w-xl text-base leading-8 text-cream/78 md:text-lg">
        Głęboko relaksujące masaże twarzy i ciała oraz sprawdzone zabiegi beauty w Kaliszu. Stworzyłam to miejsce, abyś mogła na moment zwolnić, wziąć głęboki oddech i po prostu odpocząć od codziennego biegu.
      </p>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <a href="#kontakt" class="magnetic group relative overflow-hidden rounded-full bg-cream px-7 py-4 text-center text-xs font-bold uppercase tracking-[.22em] text-cocoa shadow-soft">
          <span class="relative z-10">Umów wizytę</span>
          <span class="absolute inset-y-0 left-0 w-1/2 -translate-x-full bg-white/50 blur-xl transition group-hover:translate-x-[220%]"></span>
        </a>
        <a href="#cennik" class="magnetic rounded-full border border-cream/25 px-7 py-4 text-center text-xs font-semibold uppercase tracking-[.22em] text-cream hover:bg-cream/10">
          Zobacz cennik
        </a>
      </div>
    </div>

    <div class="relative hidden items-center justify-center lg:flex">
      <div class="animate-floatSlow relative h-[500px] w-[500px]">
        <img src="/hero-side.webp" alt="Piąty Żywioł" class="absolute inset-0 h-full w-full object-contain drop-shadow-2xl" />
        <svg class="absolute inset-0 animate-rotateBadge z-10" viewBox="0 0 500 500">
          <defs><path id="heroCircleText" d="M 250, 250 m -215, 0 a 215,215 0 1,1 430,0 a 215,215 0 1,1 -430,0" /></defs>
          <text class="fill-cream text-[13px] uppercase tracking-[.28em]"><textPath href="#heroCircleText">Piąty Żywioł &amp; Marta Włodarska Beauty &amp; Massage · </textPath></text>
        </svg>
      </div>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 hidden -translate-x-1/2 items-center gap-3 text-[10px] uppercase tracking-[.28em] text-cream/50 md:flex">
    <span>Scroll</span>
    <span class="relative h-12 w-px overflow-hidden bg-cream/20"><span class="absolute left-0 top-0 h-5 w-px animate-pulse bg-cream"></span></span>
    <span>Więcej</span>
  </div>
</section>
