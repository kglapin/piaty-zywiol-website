---
import { Icon } from 'astro-icon/components';
---

<section class="relative z-10 border-b border-cocoa/10 bg-cream">
  <div class="mx-auto grid max-w-7xl grid-cols-2 divide-x divide-y divide-cocoa/10 px-5 md:grid-cols-4 lg:px-10">
    <div class="stagger p-8 text-center reveal">
      <Icon name="lucide:leaf" class="mx-auto mb-4 h-8 w-8 text-clay stroke-[1]" />
      <h2 class="font-display text-2xl">Ajurweda</h2>
      <p class="mt-2 text-xs leading-5 text-cocoa/55">Masaże inspirowane holistyczną pracą z ciałem.</p>
    </div>
    <div class="stagger p-8 text-center reveal">
      <Icon name="lucide:hand" class="mx-auto mb-4 h-8 w-8 text-clay stroke-[1]" />
      <h2 class="font-display text-2xl">Neuro-lifting</h2>
      <p class="mt-2 text-xs leading-5 text-cocoa/55">Regeneracyjna praca z twarzą i napięciami.</p>
    </div>
    <div class="stagger p-8 text-center reveal">
      <Icon name="lucide:sparkles" class="mx-auto mb-4 h-8 w-8 text-clay stroke-[1]" />
      <h2 class="font-display text-2xl">Beauty</h2>
      <p class="mt-2 text-xs leading-5 text-cocoa/55">Zabiegi pielęgnacyjne z efektem glow.</p>
    </div>
    <div class="stagger p-8 text-center reveal">
      <Icon name="lucide:wind" class="mx-auto mb-4 h-8 w-8 text-clay stroke-[1]" />
      <h2 class="font-display text-2xl">Relaks</h2>
      <p class="mt-2 text-xs leading-5 text-cocoa/55">Spokojna atmosfera i indywidualne podejście.</p>
    </div>
  </div>
</section>
