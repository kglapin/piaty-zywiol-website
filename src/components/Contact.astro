---
---
<section id="kontakt" class="relative overflow-hidden bg-cocoa px-5 py-24 text-cream lg:px-10 lg:py-32">
  <div class="absolute left-[var(--mouse-x)] top-[var(--mouse-y)] h-96 w-96 -translate-x-1/2 -translate-y-1/2 rounded-full bg-clay/20 blur-3xl transition-[left,top] duration-300"></div>
  <div class="section-content relative mx-auto grid max-w-7xl gap-12 lg:grid-cols-[1fr_.9fr]">
    <div class="reveal">
      <p class="mb-4 text-[10px] font-semibold uppercase tracking-[.34em] text-blush">Kontakt</p>
      <h2 class="font-display text-6xl font-medium leading-[.9] tracking-[-.04em] md:text-8xl">Umów swoją chwilę spokoju.</h2>
      <p class="mt-8 max-w-lg text-sm leading-8 text-cream/65 md:text-base">Zadzwoń lub napisz przez Facebooka / Instagram, aby dobrać zabieg i zarezerwować dogodny termin.</p>

      <div class="mt-10 flex gap-5">
        <a href="tel:721050353" class="group flex h-24 w-24 items-center justify-center rounded-[1.5rem] border border-cream/15 bg-white/10 backdrop-blur-xl shadow-soft transition hover:bg-white/20 hover:border-cream/30" aria-label="Zadzwoń">
          <svg class="h-10 w-10 text-cream transition group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </a>
        <a href="https://www.facebook.com/profile.php?id=61572906601519" target="_blank" rel="noreferrer" class="group flex h-24 w-24 items-center justify-center rounded-[1.5rem] border border-cream/15 bg-white/10 backdrop-blur-xl shadow-soft transition hover:bg-white/20 hover:border-cream/30" aria-label="Facebook">
          <svg class="h-10 w-10 text-cream transition group-hover:scale-110" viewBox="0 0 24 24" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        <a href="https://www.instagram.com/piaty_zywiol_marta_wlodarska_/" target="_blank" rel="noreferrer" class="group flex h-24 w-24 items-center justify-center rounded-[1.5rem] border border-cream/15 bg-white/10 backdrop-blur-xl shadow-soft transition hover:bg-white/20 hover:border-cream/30" aria-label="Instagram">
          <svg class="h-10 w-10 text-cream transition group-hover:scale-110" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
          </svg>
        </a>
        <a href="https://booksy.com/pl-pl/354223_piaty-zywiol-marta-wlodarska-beauty-massage_salon-kosmetyczny_17173_kalisz" target="_blank" rel="noreferrer" class="group flex h-24 w-24 items-center justify-center rounded-[1.5rem] border border-cream/15 bg-white/10 backdrop-blur-xl shadow-soft transition hover:bg-white/20 hover:border-cream/30" aria-label="Booksy">
          <img src="/booksy-logo.png" alt="Booksy" class="h-14 w-14 transition group-hover:scale-110" />
        </a>
      </div>
    </div>

    <div class="reveal rounded-[2.5rem] bg-cream p-8 text-cocoa shadow-soft">
      <div class="space-y-7">
        <div>
          <p class="text-xs uppercase tracking-[.28em] text-clay font-semibold">Studio</p>
          <p class="mt-2 font-display text-2xl font-semibold">Piąty Żywioł &amp; Marta Włodarska Beauty &amp; Massage</p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-[.28em] text-clay font-semibold">Adres</p>
          <p class="mt-2 text-xl font-medium">Kalisz, ul. Babina 5</p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-[.28em] text-clay font-semibold">Telefon</p>
          <a class="mt-2 block text-xl font-bold text-cocoa" href="tel:721050353">721 050 353</a>
        </div>
        <div class="overflow-hidden rounded-[1.5rem]">
          <div data-map-placeholder class="flex min-h-[220px] flex-col items-center justify-center gap-3 bg-sand px-6 py-7 text-center">
            <p class="max-w-sm text-sm leading-6 text-cocoa/75">Mapa Google nie ładuje się automatycznie. Po jej załadowaniu Google może otrzymać Twój adres IP i informacje techniczne o przeglądarce.</p>
            <button id="load-google-map" type="button" class="rounded-full bg-cocoa px-5 py-3 text-sm font-medium text-cream transition hover:bg-cocoa/85">Załaduj mapę Google</button>
            <a href="https://maps.google.com/maps?q=Babina+5+Kalisz+Polska" target="_blank" rel="noreferrer" class="text-sm underline decoration-gold underline-offset-4">Otwórz mapę w nowej karcie</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const mapButton = document.querySelector<HTMLButtonElement>('#load-google-map');

  mapButton?.addEventListener('click', () => {
    const map = document.createElement('iframe');
    map.src = 'https://maps.google.com/maps?q=Babina+5+Kalisz+Polska&output=embed';
    map.title = 'Mapa dojazdu do Piątego Żywiołu przy ul. Babina 5 w Kaliszu';
    map.width = '100%';
    map.height = '220';
    map.style.border = '0';
    map.loading = 'eager';
    map.referrerPolicy = 'strict-origin-when-cross-origin';
    map.setAttribute('allowfullscreen', '');

    mapButton.closest('[data-map-placeholder]')?.replaceWith(map);
  });
</script>
